<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Adding report button in bank journal of accounting -->
    <record id="account_journal_dashboard_kanban_view" model="ir.ui.view">
        <field name="name">account.journal.view.kanban.inherit</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.account_journal_dashboard_kanban_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='dashboard_bank_cash_left']" position="inside">
                <t t-if="journal_type == 'bank'">
                    <a
                        name="action_open_general_ledger_wizard"
                        type="object"
                        class="oe_inline"
                    >
                       General Ledger
                    </a>
                </t>
            </xpath>
        </field>
    </record>
</odoo>
